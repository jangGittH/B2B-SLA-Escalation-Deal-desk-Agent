# Required only for model-backed conversation answers and tool selection.
# Deterministic case/review UI and memo exports work without a model key.
GOOGLE_API_KEY=your-google-api-key

# Optional single-model override (otherwise uses GEMINI_MODEL or the default).
# WORK_AGENT_MODEL=gemini-3.5-flash-lite

# Generated file storage; defaults to .work_assistant/files.
# WORK_FILES_DIR=.work_assistant/files

# PostgreSQL (migrations through Unit 10). Start with docker compose up -d, then run db-init.
# Local demo credentials only; change them for any non-local deployment.
WORK_DATABASE_URL=postgresql+psycopg://northstar:northstar-local@127.0.0.1:55432/northstar

# Persistent search: bm25 (default), lexical, or hybrid.
# Hybrid requires the retrieval extra and scripts/prepare_retrieval.py; see docs/UNIT_09.md.
# WORK_RETRIEVAL_MODE=hybrid
